#!/bin/sh
# Block commits whose staged fmorm-all.xml does not match the staged src/ files.
# Enable once per clone with:  git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
	echo "pre-commit: python3 not found, so fmorm-all.xml cannot be verified." >&2
	echo "Install Python 3, or bypass this once with: git commit --no-verify" >&2
	exit 1
fi
exec "$PY" "$(git rev-parse --show-toplevel)/build.py" --check --staged
